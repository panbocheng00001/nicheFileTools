# Docs (intentionally excluded from repo)
/doc/

# Environment / secrets (covers all subprojects — 回流 token 等密钥勿入库)
.env
.env.*
!.env.example

# Editor
.idea
.vscode/*
!.vscode/extensions.json
*.suo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache / build (subprojects also ignore their own; 这里兜底通用项)
.cache
.eslintcache
*.tsbuildinfo

# WorkBuddy project data — 默认不提交（含本地记忆/密钥回填状态）
# 如需团队共享规范，可移除此行并挑必要文件白名单
.workbuddy/
