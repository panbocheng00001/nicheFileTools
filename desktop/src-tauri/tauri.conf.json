{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nichefiletools",
  "version": "0.1.0",
  "identifier": "com.nichefiletools.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "nichefiletools — Free File Converter",
        "width": 1100,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Free file format converter (desktop)",
    "longDescription": "nichefiletools desktop — convert KFX, PRT, PVR, RAW, BLEND and more entirely on your PC. Private, no upload.",
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
